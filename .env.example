# Environment Variables Example
# Copy this file to .env and adjust values as needed

# ======================
# Backend Configuration
# ======================

# Server port
PORT=3001

# CORS allowed origin (frontend URL)
CORS_ORIGIN=http://localhost:3000

# Node environment (development | production)
NODE_ENV=production

# Default state highlight color (hex format)
# Used when a state group doesn't specify a color
DEFAULT_STATE_COLOR=#FF0000

# Logging level (optional)
# Valid values: error, warn, info, http, debug
# Default: 'debug' in development, 'info' in production
# Log levels in order of verbosity (least to most):
#   - error: Only errors (critical issues)
#   - warn: Warnings and errors (non-critical issues)
#   - info: General information + warnings + errors (recommended for production)
#   - http: HTTP requests + all above (API debugging)
#   - debug: Detailed debugging + all above (recommended for development)
# LOG_LEVEL=info

# ======================
# Frontend Configuration
# ======================

# Backend API URL (used during build time)
VITE_BACKEND_URL=http://localhost:3001

# Browser tab title (optional, defaults to "Real-time Map")
VITE_APP_TITLE=Real-time Map

# Custom favicon path (optional, defaults to /vite.svg)
# Example: VITE_APP_FAVICON=/favicon.ico
# VITE_APP_FAVICON=/vite.svg

# Show map legend (optional, defaults to true)
# Set to "false" to hide the legend
VITE_SHOW_LEGEND=true

# ======================
# Docker Configuration
# ======================

# These are used by docker-compose.yml
# Uncomment and modify if needed

# COMPOSE_PROJECT_NAME=usa-real-time-map
# DOCKER_BUILDKIT=1

# ======================
# Database Configuration
# ======================

# Enable database integration
DB_ENABLED=false

# MS SQL Server connection settings
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password

# Database connection options
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# ======================
# Polling Configuration
# ======================

# Enable polling service
POLLING_ENABLED=false

# Polling interval in milliseconds (default: 15000 = 15 seconds)
POLLING_INTERVAL=15000

# SQL query to fetch coordinates
# Use @lastPoll parameter to get only new records since last poll
# Example: SELECT * FROM coordinates WHERE created_at > @lastPoll
POLLING_QUERY=SELECT * FROM coordinates WHERE created_at > @lastPoll

# Column mapping - specify which columns contain the data
POLLING_COL_LAT=latitude
POLLING_COL_LON=longitude
POLLING_COL_LABEL=label

# Optional: specify a column containing JSON properties
# Leave empty if not using properties column
POLLING_COL_PROPERTIES=

# ======================
# Pin Storage Configuration
# ======================

# Maximum age for pins (in milliseconds)
# Default: 86400000 (24 hours)
PIN_MAX_AGE=86400000

# Cleanup interval - how often to remove expired pins (in milliseconds)
# Default: 300000 (5 minutes)
PIN_CLEANUP_INTERVAL=300000

# Compaction threshold - compact array when this many expired pins accumulate
# Default: 1000
PIN_COMPACTION_THRESHOLD=1000

# Path to persist pins (relative to backend/src or absolute)
# Default: ../data/pins.json
PIN_PERSIST_PATH=./data/pins.json

# Time window options for UI (JSON format)
# Format: {"label": milliseconds, ...}
# Default: 5/15/30 min, 1/2/4/8/16/24 hours
PIN_TIME_WINDOWS={"5 min":300000,"15 min":900000,"30 min":1800000,"1 hour":3600000,"2 hours":7200000,"4 hours":14400000,"8 hours":28800000,"16 hours":57600000,"24 hours":86400000}

# Default time window (must match a key from PIN_TIME_WINDOWS)
# Default: 1 hour
PIN_DEFAULT_TIME_WINDOW=1 hour

# ======================
# Production Settings
# ======================

# For production deployments, update these:
# CORS_ORIGIN=https://your-domain.com
# VITE_BACKEND_URL=https://api.your-domain.com
