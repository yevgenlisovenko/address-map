# Docker Compose Environment Variables
# Copy this file to .env and customize as needed
# cp .env.example .env

# ========================================
# Backend Configuration
# ========================================

# Port for backend server (default: 3001)
PORT=3001

# CORS Origins - Supports single origin or multiple comma-separated origins
# Single origin: CORS_ORIGIN=http://localhost:3000
# Multiple origins: CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_ORIGIN=http://localhost:3000

# Node environment (development, production)
NODE_ENV=production

# ========================================
# Frontend Build Configuration
# ========================================

# Backend server URL for frontend to connect to
# This is used during the Docker build process
VITE_BACKEND_URL=http://localhost:3001

# Deployment Configuration
# Specifies which deployment configuration to use from frontend/src/config/deployments/
# This controls marker icon mappings, statistics configuration, AND filter configuration
# Available options: 'default', 'client-a'
# If not set, 'default' will be used
#
# Examples:
# VITE_DEPLOYMENT_CONFIG=default
#   - Marker icons: Uses formCode (HO3, HO4, HO6, HF9)
#   - Statistics: Tracks state and formCode, shows top 5 items
#   - Filters: State and formCode filters (static dropdowns)
#
# VITE_DEPLOYMENT_CONFIG=client-a
#   - Marker icons: Uses partnerNameShort (custom partner mappings)
#   - Statistics: Tracks state and partnerNameShort, shows top 100 items
#   - Filters: State (static) and partnerNameShort (dynamic) filters
VITE_DEPLOYMENT_CONFIG=default

# ========================================
# Database Configuration (Optional)
# ========================================

# Enable database polling (true/false)
# DB_ENABLED=false

# Azure SQL Database connection settings
# DB_SERVER=your-server.database.windows.net
# DB_DATABASE=your-database
# DB_USER=your-username
# DB_PASSWORD=your-password
# DB_PORT=1433

# ========================================
# Docker Compose Usage
# ========================================

# To use this file:
# 1. Copy to .env: cp .env.example .env
# 2. Edit values as needed
# 3. Build and run: docker compose up -d

# To rebuild with different configuration:
# VITE_DEPLOYMENT_CONFIG=client-a docker compose build frontend
# docker compose up -d
