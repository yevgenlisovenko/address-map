# Client A Deployment Configuration

# Backend server URL
VITE_BACKEND_URL=http://localhost:3001

# API base URL
VITE_API_URL=http://localhost:3001

# Deployment Configuration - Use client-a icon config
VITE_DEPLOYMENT_CONFIG=client-a

# Show map legend
VITE_SHOW_LEGEND=true

# Development server port
VITE_PORT=5173

# Show/hide info panel (default: true)
VITE_SHOW_INFO_PANEL=false
# Initial visibility of info panel (default: true)
VITE_INFO_PANEL_INITIAL_VISIBLE=false

# Initial visibility of sidebar (default: false)
VITE_SIDEBAR_INITIAL_VISIBLE=true