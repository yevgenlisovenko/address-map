# Frontend Configuration
# Copy this file to .env and customize as needed

# Backend server URL (for Socket.IO and REST API)
# Development default: http://localhost:3001
# Production: Update to your backend server URL
VITE_BACKEND_URL=http://localhost:3001

# API base URL (same as backend URL in most cases)
VITE_API_URL=http://localhost:3001

# Optional: Custom application title (appears in browser tab)
# VITE_APP_TITLE=Real-time Map

# Optional: Custom favicon path
# VITE_APP_FAVICON=/favicon.ico

# Optional: Show/hide map legend (default: true)
# VITE_SHOW_LEGEND=true

# Optional: Show/hide info panel (default: true)
# VITE_SHOW_INFO_PANEL=true

# Optional: Initial visibility of map legend (default: true)
# Set to 'false' to start with legend hidden (can be shown via toggle button)
# VITE_LEGEND_INITIAL_VISIBLE=true

# Optional: Initial visibility of info panel (default: true)
# Set to 'false' to start with info panel hidden (can be shown via toggle button)
# VITE_INFO_PANEL_INITIAL_VISIBLE=true

# Optional: Initial visibility of sidebar (default: false)
# Set to 'true' to start with sidebar open
# VITE_SIDEBAR_INITIAL_VISIBLE=false

# Optional: Initial state of marker clustering (default: from deployment config)
# Overrides deployment config default if set
# User can toggle at runtime via 'C' button (preference persists in localStorage)
# Set to 'true' to enable clustering on initial load
# Set to 'false' to disable clustering on initial load
# VITE_CLUSTERING_INITIAL_ENABLED=true

# Deployment Configuration
# Specifies which deployment configuration to use from src/config/deployments/
# This controls marker icon mappings, statistics configuration, filter configuration, AND legend grouping
# Available options: 'default', 'client-a'
# If not set or config not found, 'default' will be used
#
# Examples:
# VITE_DEPLOYMENT_CONFIG=default
#   - Marker icons: Uses formCode (HO3, HO4, HO6, HF9)
#   - Statistics: Tracks state and formCode, shows top 5 items
#   - Filters: State and formCode filters (static dropdowns)
#   - Legend: No grouping (all icons unique)
#
# VITE_DEPLOYMENT_CONFIG=client-a
#   - Marker icons: Uses partnerName (custom partner mappings)
#   - Statistics: Tracks state and partnerName, shows top 100 items
#   - Filters: State (static) and partnerName (dynamic) filters
#   - Legend: Auto-groups duplicate icons (e.g., "GEICO partners" groups 4 yellow icons)
#
# Filter value modes:
#   - Static dropdown: Predefined values in config
#   - Dynamic dropdown: Auto-generated from marker data (values: 'dynamic')
#   - Text input: Contains search (no values property)
#
# Legend grouping:
#   - Auto-groups legend items with duplicate icons to save space
#   - Configurable per deployment (autoGroupDuplicates, groupLabels, defaultExpanded)
#   - Groups start collapsed by default, click to expand and see all items
#   - Example: 4 items with yellow icon become "GEICO partners (4)"
#
# VITE_DEPLOYMENT_CONFIG=default

# Development Server Port
# Port for Vite dev server (default: 5173)
# If port is taken, Vite will try the next available port
# VITE_PORT=5173
