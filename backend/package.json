{
  "name": "real-time-map-backend",
  "version": "1.0.0",
  "description": "Backend server for Real-time Map application",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "start:instance-2": "node -r dotenv/config src/server.js dotenv_config_path=.env.instance-2.local",
    "dev:instance-2": "node --watch -r dotenv/config src/server.js dotenv_config_path=.env.instance-2.local",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\""
  },
  "keywords": [
    "socket.io",
    "express",
    "geocoding",
    "real-time"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "mssql": "^12.0.0",
    "socket.io": "^4.6.1",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  }
}
