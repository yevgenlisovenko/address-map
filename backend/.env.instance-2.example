# Instance 2 Configuration
# This is an example configuration for running a backend instance with a different data source

# Service Configuration
SERVICE_NAME=real-time-map-instance-2
ENVIRONMENT_NAME=instance-2
PORT=3002

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5174,http://localhost:3000

# Database Configuration
DB_ENABLED=true
DB_SERVER=your-server.database.windows.net
DB_PORT=1433
DB_DATABASE=database_b
DB_USER=your_user
DB_PASSWORD=your_password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_REQUEST_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=15000

# Database Polling Configuration
POLLING_ENABLED=true
POLLING_INTERVAL=15000
POLLING_QUERY=SELECT * FROM YourTable WHERE ID > @lastId ORDER BY ID
POLLING_ID_COLUMN=ID
POLLING_LATITUDE_COLUMN=Latitude
POLLING_LONGITUDE_COLUMN=Longitude
POLLING_LABEL_COLUMN=Label

# Data Persistence (Instance-Specific)
PIN_PERSIST_PATH=backend/data/instance-2/pins.json
STATE_HIGHLIGHTS_PATH=backend/data/instance-2/state-highlights.json
LOG_DIR=backend/logs/instance-2

# Pin Storage Configuration
PIN_MAX_AGE=86400000
PIN_CLEANUP_INTERVAL=300000
PIN_COMPACTION_THRESHOLD=1000
PIN_DEFAULT_TIME_WINDOW=1 hour

# State Highlight Configuration
DEFAULT_STATE_COLOR=#FF0000

# Field Injection Configuration
DEPLOYMENT_CONFIG=client-a

# AI Configuration (Optional)
AI_ENABLED=false
# OPENAI_API_KEY=your-api-key-here
# OPENAI_MODEL=gpt-4

# API Configuration
API_BODY_LIMIT=10mb

# Logging Configuration
LOG_LEVEL=info
NODE_ENV=production
