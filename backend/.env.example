# Service Identification
# Used in all log entries for easy filtering in log aggregation systems
SERVICE_NAME=real-time-map
# Environment label for logs (e.g., dev, staging, prod, qa)
# Can differ from NODE_ENV for flexible naming
ENVIRONMENT_NAME=dev

# Server Configuration
PORT=3001
# CORS Origins - Supports single origin or multiple comma-separated origins
# Single origin: CORS_ORIGIN=http://localhost:5173
# Multiple origins: CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8080
CORS_ORIGIN=http://localhost:5173

# Database Configuration (Optional)
DB_ENABLED=false
DB_SERVER=your-server.database.windows.net
DB_PORT=1433
DB_DATABASE=your-database
DB_USER=your-username
DB_PASSWORD=your-password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Polling Configuration (Optional)
POLLING_ENABLED=false
POLLING_INTERVAL=15000
INIT_QUERY=SELECT max(id) max_id FROM coordinates
# SQL query to fetch new records (supports multiline with quotes)
POLLING_QUERY="SELECT
  id,
  latitude,
  longitude,
  label,
  created_at,
  properties
FROM coordinates
WHERE id > @lastPoll
ORDER BY id DESC"
POLLING_COL_LAT=latitude
POLLING_COL_LON=longitude
POLLING_COL_LABEL=label
POLLING_COL_PROPERTIES=

# State Highlight Configuration
DEFAULT_STATE_COLOR=#FF0000

# Pin Storage Configuration
PIN_MAX_AGE=86400000
PIN_CLEANUP_INTERVAL=300000
PIN_COMPACTION_THRESHOLD=1000
PIN_PERSIST_PATH=
# Optional: Custom time window options as JSON
# Format: { "label": milliseconds, ... }
# PIN_TIME_WINDOWS={"5 min":300000,"15 min":900000,"30 min":1800000,"1 hour":3600000,"2 hours":7200000,"4 hours":14400000,"8 hours":28800000,"16 hours":57600000,"24 hours":86400000}
PIN_DEFAULT_TIME_WINDOW=1 hour

# AI Configuration
AI_ENABLED=false
OPENAI_API_KEY=your-openai-api-key
# OpenAI API base URL - customize for Azure OpenAI, custom endpoints, or proxies
# Standard OpenAI: https://api.openai.com/v1
# Azure OpenAI: https://your-resource.openai.azure.com/openai/deployments/your-deployment
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7
# Set to false if behind corporate proxy with self-signed certificates (SSL inspection)
# This disables SSL certificate verification for OpenAI API requests only
AI_REJECT_UNAUTHORIZED=true
AI_ALLOWED_PROPERTIES=
# Maximum length of the AI's response (output). Doesn't affect input (request)
# Maximum number of markers allowed for AI analysis (default: 1000)
# This prevents excessive API costs and token limit errors
AI_MAX_MARKERS=1000
# API body size limit for JSON payloads (default: 10mb)
# Increase if sending large marker datasets for AI analysis
API_BODY_LIMIT=10mb

# Logging Configuration
LOG_LEVEL=debug
# Node.js environment - affects runtime behavior (Express optimizations, default log level)
# Values: development, production, test
NODE_ENV=development
